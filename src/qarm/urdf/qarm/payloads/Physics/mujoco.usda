over "QARM"
{
    over "Physics"
    {
        def MjcActuator "base_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </QARM/Physics/base_joint>
        }

        def MjcActuator "shoulder_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </QARM/Physics/shoulder_joint>
        }

        def MjcActuator "arm_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </QARM/Physics/arm_joint>
        }

        def MjcActuator "wrist_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </QARM/Physics/wrist_joint>
        }


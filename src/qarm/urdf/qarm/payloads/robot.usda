#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "QARM"
    doc = """Generated from Composed Stage of root layer /tmp/tmp9nnub1t1/QARM.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_qarm_dv1ub_dr/usdex_qarm/QARM.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_qarm_dv1ub_dr/temp_qarm/qarm.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "QARM" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </QARM/Physics/world_base_joint>,
        </QARM/Physics/base_joint>,
        </QARM/Physics/shoulder_joint>,
        </QARM/Physics/arm_joint>,
        </QARM/Physics/wrist_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </QARM/Geometry/world/base_link>,
        </QARM/Geometry/world/base_link/YAW>,
        </QARM/Geometry/world/base_link/YAW/BICEP>,
        </QARM/Geometry/world/base_link/YAW/BICEP/FOREARM>,
        </QARM/Geometry/world/base_link/YAW/BICEP/FOREARM/tn__ENDEFFECTOR_lG>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "world"
        {
            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "base_link" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }

                over "YAW" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "YAW" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }

                    over "BICEP" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "BICEP" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }

                        over "FOREARM" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "FOREARM" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                            }

                            over "tn__ENDEFFECTOR_lG" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "tn__ENDEFFECTOR_lG" (
                                    prepend apiSchemas = ["IsaacSiteAPI"]
                                )
                                {
                                }

                                over "tn__ENDEFFECTOR_1_iJ" (
                                    prepend apiSchemas = ["IsaacSiteAPI"]
                                )
                                {
                                }

                                over "tool_frame" (
                                    prepend apiSchemas = ["IsaacSiteAPI"]
                                )
                                {
                                }
                            }

                            over "FOREARM_1" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                            }
                        }

                        over "BICEP_1" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }

                    over "YAW_1" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }
                }

                over "base_link_1" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "world_base_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "shoulder_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "arm_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}


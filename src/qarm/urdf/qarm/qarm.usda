#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "QARM"
    doc = """Generated from Composed Stage of root layer /tmp/tmp9nnub1t1/QARM.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_qarm_dv1ub_dr/usdex_qarm/QARM.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_qarm_dv1ub_dr/temp_qarm/qarm.usd


Generated from Composed Stage of root layer /home/earth157/entech_quanser_ros2_ws/src/qarm/urdf/qarm/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "QARM" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

over "Flattened_Prototype_11"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_11.inputs:diffuseColor>
        float inputs:metallic.connect = </Flattened_Prototype_11.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_11.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_11.inputs:roughness>
        token outputs:displacement
        token outputs:surface
    }
}


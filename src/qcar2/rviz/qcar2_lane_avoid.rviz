# Lane following + obstacle avoidance, all three views in one window.
#
#   Image  /lane/debug_image  what the lane detector sees: masks, the two
#                             look-ahead bands, the boundaries it picked, the
#                             aim point, and the mode/error/heading text
#   Marker /lane/windows     the two boxes the decision is actually made from,
#                             GREEN while empty and RED while occupied: FRONT
#                             (|y| <= corridor_half_width, out to
#                             trigger_distance, pointing where the car points)
#                             and BEHIND, which is held over the LANE the car
#                             pulled out of - so while avoiding it stays put
#                             over that lane instead of swinging out with the
#                             bodywork. Watch it go red as the obstacle enters
#                             it and green once the lane is free again: that
#                             transition is what ends the overtake. A cloud of
#                             lidar points says nothing about which of them are
#                             being counted; these say exactly.
#   Image  /realsense_depth   the raw depth camera, 32FC1 - normalised for
#                             display, so near is dark and far is bright. This
#                             is what /scan_depth is a single band out of, and
#                             the place to look when the depth half sees
#                             nothing: a black frame means the camera is inside
#                             geometry, an empty one means it is not rendering
#   LaserScan /scan           lidar, WHITE - 360 deg, sees only above 0.194 m
#   LaserScan /scan_depth     depth camera, CYAN - +/-33 deg, reaches down to
#                             ~0.09 m tall at 2 m, capped at 3 m
#
# Two colours on purpose: where the two agree the obstacle is tall enough for
# both, and cyan alone is exactly the case the lidar cannot see.
#
# Fixed Frame is base_link: this route has no map and no map->odom, so anything
# else leaves the displays waiting on a transform that never arrives.
Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Decision windows1
        - /LaserScan (lidar)1
        - /LaserScan (depth)1
      Splitter Ratio: 0.5
    Tree Height: 500
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LaserScan (lidar)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 0; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LaserScan (depth)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan_depth
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Decision windows
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lane/windows
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Lane detector
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lane/debug_image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Depth camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /realsense_depth
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: -1.5707963705062866
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 55
      Target Frame: base_link
      Value: TopDownOrtho (rviz_default_plugins)
      X: 1.5
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Depth camera:
    collapsed: false
  Lane detector:
    collapsed: false
  Width: 1500
  X: 60
  Y: 60

Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map1
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
      Alpha: 0.5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Update Interval: 0
      Frame Timeout: 15
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true
      Update Topic:
        Value: /map_updates
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Covariance:
        Value: false
      Keep: 100
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Alpha: 1
        Color: 255; 25; 0
        Head Length: 0.1
        Head Radius: 0.06
        Shaft Length: 0.2
        Shaft Radius: 0.02
        Value: Arrow
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Image
      Name: RGB
      Enabled: true
      Normalize Range: true
      Max Intensity: 4096
      Min Intensity: 0
      Topic:
        Value: /realsense/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Image
      Name: Depth (registered)
      Enabled: true
      # 32FC1 metres, NOT normalized: auto-normalising against a 12 m far wall
      # crushes everything nearby into the first few grey levels and the panel
      # looks black. Fixed 0-6 m matches what the car actually navigates by.
      Normalize Range: false
      Max Intensity: 6
      Min Intensity: 0
      Topic:
        Value: /realsense/depth/image_raw
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/PointCloud2
      Name: RTAB-Map 3D cloud
      Enabled: true
      Style: Points
      Size (Pixels): 3
      Alpha: 1
      Decay Time: 0
      Color Transformer: RGB8
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Use Fixed Frame: true
      Topic:
        Value: /cloud_map
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 15
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.0
      Yaw: 3.6
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false

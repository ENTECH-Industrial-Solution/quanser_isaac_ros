# --- colcon build artifacts (regenerated by `colcon build`) ---
build/
install/
log/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# --- editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store

